# Copy to .env.development (for `npm run dev`) and adjust. Never commit real secrets.

# Test mode for sign-in. "true" ONLY in the dev server:
#  - the one-time code step accepts the fixed test code 123456 for any valid Nigerian number;
#  - the OTP screen shows a "Test mode" banner with an "Autofill test code" button;
#  - the login screen lists the demo accounts (+234 800 000 00xx), and "Reset demo data" appears.
# Anything other than "true" (or unset) turns all of this off. `npm run build` refuses to run while it
# is "true", and fails if the test code or a dev-only banner is found in the production bundle.
VITE_MOCK_AUTH=false
