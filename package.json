{
  "name": "zamani-ng-market-hub",
  "private": true,
  "description": "ZAMANI NG MARKET HUB monorepo: the web app, the API and the shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:tz": "npm run test:tz --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "i18n:check": "npm run i18n:check --workspace apps/web",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:logs": "docker compose logs -f",
    "db:check": "npm run db:check --workspace apps/api",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:studio": "npm run db:studio --workspace apps/api",
    "test:integration": "npm run test:integration --workspace apps/api"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
