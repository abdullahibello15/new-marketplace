{
  "name": "zamani-ng-market-hub",
  "private": true,
  "description": "ZAMANI NG MARKET HUB monorepo: the web app, the API and the shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:tz": "npm run test:tz --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "i18n:check": "npm run i18n:check --workspace apps/web"
  }
}
