# Copy to .env (cp apps/api/.env.example apps/api/.env). Never commit real secrets.
# These match docker-compose.yml at the repo root (npm run db:up).

DATABASE_URL=postgres://zamani:zamani@127.0.0.1:5432/zamani
# Integration tests use their own database, created by docker/postgres/init.sql.
DATABASE_URL_TEST=postgres://zamani:zamani@127.0.0.1:5432/zamani_test
REDIS_URL=redis://127.0.0.1:6379

PORT=3000
LOG_LEVEL=info
# Error reporting: off unless set.
SENTRY_DSN=
# Dev only. The API refuses to start if this is set at all when NODE_ENV=production.
OTP_TEST_MODE=false
