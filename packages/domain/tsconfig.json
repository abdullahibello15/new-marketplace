{
  "compilerOptions": {
    "target": "ES2020",
    // No DOM: the rules run on the server too, so browser globals must not type-check here.
    "lib": ["ES2020"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
